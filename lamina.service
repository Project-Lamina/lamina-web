[Unit]
Description=Lamina web service
Wants=network-online.target
After=network-online.target

# The server now refuses to start on a bad config (missing templates or static
# directory), so without a limit a typo becomes an endless restart loop that buries
# the reason in the journal. Give up after 5 attempts in 60s and stay failed, which
# is visible in systemctl status.
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
# Your working dir (optional, but handy for relative paths)
WorkingDirectory=%h/hosting/lamina-web

# Start the app (use %h instead of ~; systemd doesn’t expand ~)
ExecStart=%h/hosting/lamina-web/target/release/lamina-web

# Auto-restart on crash or non-zero exit
Restart=on-failure
RestartSec=1s

# Stop leaks or a runaway request from taking the host down with them.
MemoryMax=512M

# Shutdown drains in-flight requests, which is quick; do not wait the default 90s
# if something wedges.
TimeoutStopSec=20s

# Harden a bit (tweak as needed)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=%h/hosting/lamina-web

# Optional env
# Environment=RUST_LOG=info
Environment=PORT=5001

[Install]
WantedBy=default.target

